# Notification Service - Environment Variables Example
# Copy this file and fill in your values.
# These env vars override config/development.yaml or config/production.yaml
# via config/custom-environment-variables.yaml

# Kafka
KAFKA_BROKER=["localhost:9092"]
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Mail (SMTP)
# For dev: use Ethereal (https://ethereal.email) for a free test mailbox
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@pizza-restaurant.com

# CORS - Client frontend origin (for order links in email)
CLIENT_UI_DOMAIN=http://localhost:5173
